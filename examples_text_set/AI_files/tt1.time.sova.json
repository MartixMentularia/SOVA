    {
      "uid": "u-30007232",
      "originalId": "m-014",
      "text": "домом Загорского ",
      "date": "1902-09-18T20:15:00",
      "note_date": "Гл. 7. Прибытие к дому Загорского с похищенной."
    },
    {
      "uid": "u-024ac6f0",
      "originalId": "t-007",
      "text": "Обруба ",
      "date": "1902-10-05T10:00:00",
