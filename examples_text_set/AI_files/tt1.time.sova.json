    {
      "uid": "u-4a246e95",
      "originalId": "m-028",
      "text": "деревянным домом ",
      "date": "1903-01-20T06:45:00",
      "note_date": "Гл. 7 ч.2. Филька продаёт лошадь Ахмету в Заисточье."
    },
    {
      "uid": "u-7cfe2a2e",
      "originalId": "m-029",
      "text": "около окна ",
      "date": "1903-01-20T05:30:00",
      "note_date": "Гл. 7 ч.2. Козырь ждёт выезда Шумкова. Раннее утро."
    },
    {
      "uid": "u-ebe49b88",
      "originalId": "m-030",
      "text": "дома Загорского ",
      "date": "1903-01-28T18:00:00",
      "note_date": "Гл. 8 ч.2. Таня и Панфилыч ждут Загорского. Зимний вечер."
    },
    {
      "uid": "u-8df20246",
      "originalId": "m-031",
      "text": "к Краверу ",
      "date": "1903-01-29T10:00:00",
      "note_date": "Гл. 9 ч.2. Загорский едет к Краверу на Миллионную. Утро."
    },
    {
      "uid": "u-1e901470",
      "originalId": "m-033",
      "text": "Дома ",
      "date": "1903-01-29T19:00:00",
      "note_date": "Гл. 9 ч.2. Загорский заходит домой перед театром."
    },
    {
      "uid": "u-52e8ceae",
      "originalId": "m-032",
      "text": "театр ",
      "date": "1903-01-29T20:30:00",
      "note_date": "Гл. 9 ч.2. Бенефис Дерюгиной в театре Королёва."
    },
    {
      "uid": "u-c6b4e6ca",
      "originalId": "m-034",
      "text": "Егорин ",
      "date": "1903-04-12T11:00:00",
      "note_date": "Гл. 10 ч.2. «В один прекрасный весенний день». Кочеров просит совета."
    },
    {
      "uid": "u-72d1927f",
      "originalId": "t-022",
      "text": "Большой улицы ",
      "date": "1903-07-15T22:30:00",
      "note_date": "Гл. 11 ч.2. «Теплая июльская ночь». Прогулка."
    },
    {
      "uid": "u-59475f9a",
      "originalId": "t-025",
      "text": "городской пристани ",
      "date": "1903-07-15T23:00:00",
      "note_date": "Гл. 11 ч.2. Егорин и Кочеров на пароходе."
    },
    {
      "uid": "u-20b4b624",
      "originalId": "t-001",
      "text": "базарной площади ",
      "date": "1903-07-15T23:30:00",
      "note_date": "Гл. 11 ч.2. Идут через площадь."
    },
    {
      "uid": "u-b5ad7f4d",
      "originalId": "t-010",
      "text": "Большой улице ",
      "date": "1903-07-15T23:45:00",
      "note_date": "Гл. 11 ч.2. Встреча с женщиной."
    },
    {
      "uid": "u-860bbd12",
      "originalId": "t-012",
      "text": "Ямского переулка ",
      "date": "1903-07-15T23:55:00",
      "note_date": "Гл. 11 ч.2. Угол Ямского."
    },
    {
      "uid": "u-95e0965f",
      "originalId": "t-019",
      "text": "Дом офицеров ",
      "date": "1903-07-16T00:15:00",
      "note_date": "Гл. 12 ч.2. Кочеров входит в Общественное собрание."
    },
    {
      "uid": "u-a6803ab8",
      "originalId": "m-035",
      "text": "флигелем ",
      "date": "1903-07-16T00:40:00",
      "note_date": "Гл. 12 ч.2. Егорин проникает во флигель."
    },
    {
      "uid": "u-d1befe3b",
      "originalId": "m-036",
      "text": "собрания ",
      "date": "1903-07-16T01:30:00",
      "note_date": "Гл. 12 ч.2. Кочеров следит за жертвой в собрании."
    },
    {
      "uid": "u-e49bc0ad",
      "originalId": "t-027",
      "text": "Театральный переулок ",
      "date": "1903-07-16T02:15:00",
      "note_date": "Гл. 13 ч.2. Егорин убегает после убийства."
    },
    {
      "uid": "u-2fc581c2",
      "originalId": "t-030",
      "text": "Московскому тракту ",
      "date": "1903-07-16T02:45:00",
      "note_date": "Гл. 13 ч.2. Егорин идёт по тракту."
    },
    {
      "uid": "u-3c0c5461",
      "originalId": "m-037",
      "text": "своей квартиры ",
      "date": "1903-07-16T03:15:00",
      "note_date": "Гл. 13 ч.2. Егорин возвращается домой."
    },
    {
      "uid": "u-5b7ffa3b",
      "originalId": "t-032",
      "text": "Симоновской ",
      "date": "1903-07-16T03:30:00",
      "note_date": "Гл. 13 ч.2. Спускается к Томи топить улики."
    },
    {
      "uid": "u-2774d364",
      "originalId": "t-034",
      "text": "Томи ",
      "date": "1903-07-16T03:45:00",
      "note_date": "Гл. 13 ч.2. Бросает вещи в реку. Нападение шпаны."
    },
    {
      "uid": "u-74731aa8",
      "originalId": "t-036",
      "text": "В столовой ",
      "date": "1903-07-16T08:00:00",
      "note_date": "Гл. 14 ч.2. Кочеров спит в столовой. Утро."
    },
    {
      "uid": "u-963ed9a6",
      "originalId": "t-039",
      "text": "Исток ",
      "date": "1903-07-16T09:30:00",
      "note_date": "Гл. 14 ч.2. Оборванцы несут вещи скупщику."
    },
    {
      "uid": "u-fbb5555f",
      "originalId": "t-040",
      "text": "Правой стороне Томи ",
      "date": "1903-07-16T12:00:00",
      "note_date": "Гл. 14 ч.2. Шпана отдыхает на берегу. Полдень."
    },
    {
      "uid": "u-ca0e0a9f",
      "originalId": "m-038",
      "text": "домов был единолично Кочеров ",
      "date": "1903-08-20T10:00:00",
      "note_date": "Гл. 15 ч.2. «Прошла неделя». Кочеров и Катя едут на бега. Август."
    },
    {
      "uid": "u-3e9f8d13",
      "originalId": "m-039",
      "text": "ипподрома ",
      "date": "1903-08-20T12:30:00",
      "note_date": "Гл. 16 ч.2. На ипподроме. Катя встречает Козыря."
    },
    {
      "uid": "u-9391c650",
      "originalId": "m-040",
      "text": "воротам Кати ",
      "date": "1903-11-15T19:00:00",
      "note_date": "Гл. 17 ч.2. «Прошло три месяца. Глубокая поздняя осень»."
    },
    {
      "uid": "u-441ec21c",
      "originalId": "t-017",
      "text": "Общественное собрание ",
      "date": "1904-03-04T20:00:00",
      "note_date": "Гл. 18 ч.2. Масленица в 1904 г. (по н.ст. начало марта). Маскарад."
    },
    {
      "uid": "u-5937a7f5",
      "originalId": "m-041",
      "text": " \"России \" ",
      "date": "1904-03-04T23:00:00",
      "note_date": "Гл. 18 ч.2. Егорин и «человек в маске» в кабинете."
    },
    {
      "uid": "u-63e0ae62",
      "originalId": "m-042",
      "text": "трактира Чебукидзе ",
      "date": "1904-03-28T22:00:00",
      "note_date": "Гл. 19 ч.2. «Был конец марта». Совещание тройки."
    },
    {
      "uid": "u-0f023e93",
      "originalId": "t-043",
      "text": "Преображенской ",
      "date": "1904-04-12T08:00:00",
      "note_date": "Гл. 20 ч.2. «Апрель месяц». Утро дня ограбления."
    },
    {
      "uid": "u-0a4e75c4",
      "originalId": "m-043",
      "text": "на углу Никитской ",
      "date": "1904-04-12T08:30:00",
      "note_date": "Гл. 20 ч.2. Егорин слезает у Никитской."
    },
    {
      "uid": "u-3d7ed731",
      "originalId": "m-044",
      "text": "трактиру Чебукидзе ",
      "date": "1904-04-12T08:45:00",
      "note_date": "Гл. 20 ч.2. Кочеров забирает Махаладзе."
    },
    {
      "uid": "u-fb29c0b1",
      "originalId": "t-001",
      "text": "Обруба ",
      "date": "1904-04-12T09:00:00",
      "note_date": "Гл. 20 ч.2. Кочеров оставляет Махаладзе на Обрубе."
    },
    {
      "uid": "u-1969f893",
      "originalId": "t-003",
      "text": "Воскресенскую гору ",
      "date": "1904-04-12T09:05:00",
      "note_date": "Гл. 20 ч.2. Махаладзе едет на вокзал."
    },
    {
      "uid": "u-535e8c98",
      "originalId": "t-004",
      "text": "Большой улице ",
      "date": "1904-04-12T09:10:00",
      "note_date": "Гл. 20 ч.2. Кочеров идёт к Егорину."
    },
    {
      "uid": "u-af20b64d",
      "originalId": "m-045",
      "text": "магазина Щепкина и Сковородина ",
      "date": "1904-04-12T09:12:00",
      "note_date": "Гл. 20 ч.2. Встреча у магазина. Наблюдение."
    },
    {
      "uid": "u-66fedaa5",
      "originalId": "m-046",
      "text": "главная касса Сибирской железной дороги ",
      "date": "1904-04-12T09:15:00",
      "note_date": "Гл. 20 ч.2. Артельщики выезжают из банка."
    },
    {
      "uid": "u-59eeaae7",
      "originalId": "m-058",
      "text": "во двор банка ",
      "date": "1904-04-12T09:16:00",
      "note_date": "Гл. 20 ч.2. Заглядывают во двор."
    },
    {
      "uid": "u-86a7b722",
      "originalId": "t-009",
      "text": "Ямского переулка ",
      "date": "1904-04-12T09:20:00",
      "note_date": "Гл. 20 ч.2. Садятся к «своему» извозчику."
    },
    {
      "uid": "u-472f9e77",
      "originalId": "t-011",
      "text": "Большую улицу ",
      "date": "1904-04-12T09:25:00",
      "note_date": "Гл. 20 ч.2. Свернул на Большую вслед за артельщиками."
    },
    {
      "uid": "u-849414d0",
      "originalId": "t-019",
      "text": "вокзал Томск-2 ",
      "date": "1904-04-12T09:00:00",
      "note_date": "Гл. 21. Асан и Козырь идут к вокзалу. «Приблизительно за час до выезда артельщиков»."
    },
    {
      "uid": "u-8c6ed85a",
      "originalId": "t-020",
      "text": "улица Вокзальная ",
      "date": "1904-04-12T09:15:00",
      "note_date": "Гл. 21. Идут по Вокзальному шоссе к месту засады."
    },
    {
      "uid": "u-f3dbf218",
      "originalId": "t-023",
      "text": "церкви Воскресенья Господня ",
      "date": "1904-04-12T09:30:00",
      "note_date": "Гл. 21. Воскресенское кладбище. Место ожидания."
    },
    {
      "uid": "u-779064c3",
      "originalId": "t-026",
      "text": "Томской пересыльной тюрьмы ",
      "date": "1904-04-12T09:35:00",
      "note_date": "Гл. 21. Видна пересыльная тюрьма. Курят, ждут телегу Махаладзе."
    },
    {
      "uid": "u-a4c6bb6c",
      "originalId": "m-060",
      "text": "Воскресенского кладбища ",
      "date": "1904-04-12T10:05:00",
      "note_date": "Гл. 21. Нападение и убийство артельщика у кладбища. «Все произошло за десять минут»."
    },
    {
      "uid": "u-ca094364",
      "originalId": "t-027",
      "text": "Кустарной ",
      "date": "1904-04-12T10:20:00",
      "note_date": "Гл. 21. Асан и Козырь скрываются от толпы через переулки Кустарной."
    },
    {
      "uid": "u-0943c9d6",
      "originalId": "m-047",
      "text": "На дворе Орлихи ",
      "date": "1904-04-12T10:45:00",
      "note_date": "Гл. 21. Егорин и Кочеров в панике пытаются спрятаться у Орлихи, но её нет дома."
    },
    {
      "uid": "u-39035407",
      "originalId": "m-048",
      "text": "в углу каретника ",
      "date": "1904-04-12T11:15:00",
      "note_date": "Гл. 21. Прячут чемодан в каретнике Андросихи на Акимовской."
    },
    {
      "uid": "u-bddf6bac",
      "originalId": "m-049",
      "text": "к себе во двор ",
      "date": "1904-04-12T11:45:00",
      "note_date": "Гл. 21. Кочеров, бросив Егорина, въезжает к себе во двор."
    },
    {
      "uid": "u-297726a1",
      "originalId": "m-050",
      "text": "пивная Голубка ",
      "date": "1904-04-12T12:30:00",
      "note_date": "Гл. 22. Асан и Козырь у Голубка. Дележ 79 тысяч. «Обедня еще не кончилась»."
    },
    {
      "uid": "u-bdf92ad0",
      "originalId": "m-051",
      "text": " \"Европа \" ",
      "date": "1904-04-14T20:00:00",
      "note_date": "Гл. 23. «Дня через два после убийства». Асан и Козырь пьют шампанское в «Европе»."
    },
    {
      "uid": "u-c16719c7",
      "originalId": "t-008",
      "text": "Большой улицы ",
      "date": "1904-04-14T22:15:00",
      "note_date": "Гл. 24. Асан выходит из «Европы» и едет по Большой улице."
    },
    {
      "uid": "u-01e49f78",
      "originalId": "m-052",
      "text": "переулков Вокзальной слободки ",
      "date": "1904-04-14T22:30:00",
      "note_date": "Гл. 24. Асан едет в Вокзальную слободку, чтобы забрать вещи."
    },
    {
      "uid": "u-897060fe",
      "originalId": "m-053",
      "text": "своей квартирой ",
      "date": "1904-04-14T22:40:00",
      "note_date": "Гл. 24. Асан останавливается у своей квартиры. Нападение полиции и арест."
    },
    {
      "uid": "u-eb669656",
      "originalId": "m-054",
      "text": "ближайшему участку. ",
      "date": "1904-04-14T23:00:00",
      "note_date": "Гл. 24. Асана везут в полицейский участок. Допрос и камера."
    },
    {
      "uid": "u-f529e39f",
      "originalId": "m-055",
      "text": "на квартиру ",
      "date": "1904-04-15T04:30:00",
      "note_date": "Гл. 24. Асан совершает побег из участка и возвращается на квартиру к Янкелю. Раннее утро."
    },
    {
      "uid": "u-72846042",
      "originalId": "m-056",
      "text": "пивной Голубка ",
      "date": "1904-04-15T05:00:00",
      "note_date": "Гл. 24. Асан убивает Голубка кинжалом. Месть за предательство. Рассвет."
    },
    {
      "uid": "u-9f4af57f",
      "originalId": "m-057",
      "text": "пересыльной тюрьмы ",
      "date": "1904-05-15T10:00:00",
      "note_date": "Гл. 25. «Теплое майское утро». Кочеров в одиночке, свидание с Катей."
    },
    {
      "uid": "u-1d27e5f5",
      "originalId": "t-022",
      "text": "Окружного суда в Томске ",
      "date": "1904-12-05T10:00:00",
      "note_date": "Гл. 25. «В первых числах декабря». Суд и оглашение приговора."
    }
  ]
}