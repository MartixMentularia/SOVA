    {
      "uid": "u-b381217b",
      "originalId": "m-023",
      "text": "собственной квартире ",
      "date": "1903-01-19T18:00:00",
      "note_date": "Гл. 3 ч.2. Вечеринка у Козыря, «часов в шесть вечера»."
