    {
      "uid": "u-a760708b",
      "originalId": "m-027",
      "text": "у себя в квартире ",
      "date": "1903-01-19T22:00:00",
      "note_date": "Гл. 6 ч.2. Шумков у себя. Приход Козыря и Фильки (~10 часов)."
