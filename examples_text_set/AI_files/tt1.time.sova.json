    },
    {
      "uid": "u-59c1a8f7",
      "originalId": "t-041",
      "text": "Савиных ",
      "date": "1903-01-19T01:40:00",
      "note_date": "Гл. 2 ч.2. Возвращение на Евгеньевскую/Савиных, рассвет. Дележ."
