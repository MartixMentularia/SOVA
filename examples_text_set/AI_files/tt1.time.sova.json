    {
      "uid": "u-6d480d4b",
      "originalId": "m-024",
      "text": "у себя в столовой ",
      "date": "1903-01-22T18:00:00",
      "note_date": "Гл. 4 ч.2. «Два дня спустя». Егорин получает послание от шайки."
    },
    {
      "uid": "u-d7d69c2f",
      "originalId": "m-025",
      "text": "штаб-квартира ",
      "date": "1903-01-22T20:30:00",
